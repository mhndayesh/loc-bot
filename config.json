{
  "provider": "lmstudio",
  "providers": {
    "ollama": {
      "base_url": "http://localhost:11434",
      "api_format": "ollama",
      "api_key": "ollama",
      "default_model": "llama3.2:3b"
    },
    "lmstudio": {
      "base_url": "http://localhost:1234/v1",
      "api_format": "openai",
      "api_key": "lm-studio",
      "default_model": "bullmoose-0.1-llama-3-8b-alpha"
    }
  },
  "model": "ibm/granite-4-h-tiny",
  "temperature": 0.1,
  "num_ctx": 32768,
  "max_tokens": 0,
  "thinking_enabled": true,
  "embedding_provider": "lmstudio",
  "embedding_model": "text-embedding-nomic-embed-text-v1.5",
  "heartbeat_interval": 600,
  "permissions": {
    "run_command": true,
    "write_file": true,
    "read_file": true,
    "list_dir": true,
    "create_tool": true,
    "append_file": true,
    "sync_skills": true,
    "compact_memory": true,
    "update_state": true
  },
  "test_key": "test_value",
  "heartbeat_running": false
}